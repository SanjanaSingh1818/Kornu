VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Add these after creating Stripe Test-mode Prices in the Dashboard.
STRIPE_PRICE_ID_PKT_5=
STRIPE_PRICE_ID_PKT_TOTAL_5=
STRIPE_PRICE_ID_PKT_10=
STRIPE_PRICE_ID_PKT_MELLAN=
STRIPE_PRICE_ID_PKT_STOR=
STRIPE_PRICE_ID_PKT_INTENSIV=

# In Stripe, point a webhook endpoint at /api/stripe/webhook and subscribe to
# checkout.session.completed and checkout.session.async_payment_succeeded.
# Copy that endpoint's signing secret here; use the same Stripe mode as STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=

# Set these in the app deployment environment (for example, Vercel), not in the Resend dashboard.
# Resend API key for order notifications sent to info@kornu.se (server-side only, never prefix with VITE_).
RESEND_API_KEY=
# Optional recipient for payment notification emails (defaults to info@kornu.se).
CLIENT_EMAIL=info@kornu.se
# Temporary app-side secret for POST /api/resend-test; this is not a Resend API key.
RESEND_TEST_SECRET=
# Preferred sender address for order emails; the domain must be verified in Resend.
RESEND_FROM_EMAIL=Kör Nu Trafikskola <info@kornu.se>
# Backward-compatible sender override; used when RESEND_FROM_EMAIL is unset.
ORDER_NOTIFICATION_FROM=

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Template for the automatic confirmation email sent to the person who filled in the form.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Sanity CMS (see SANITY.md). Leave the project ID empty to use the local content.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
# Only needed to run the seed script. Editor token from sanity.io/manage > API > Tokens.
# Never prefix it with VITE_ (that would publish it in the website bundle).
SANITY_WRITE_TOKEN=

# Google Business Profile reviews (server-side only, never prefix with VITE_). Run `npm run google:auth` once to get these.
# The OAuth consent screen must be set to "In production", otherwise Google expires the refresh token after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
# Optional: hide reviews below this star rating (default 4).
GOOGLE_REVIEWS_MIN_RATING=
